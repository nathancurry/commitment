# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/commitment/config.env.
# Shell syntax is intentional; this is trusted operator configuration.
COMMITMENT_REPO=/absolute/path/to/commitment
COMMITMENT_BRANCH=main
# Trusted host-side fetch/push URL. Never inferred from agent-writable Git config.
COMMITMENT_UPSTREAM_URL=https://github.com/example/commitment.git

LAB_REPO=/absolute/path/to/commitment-lab
LAB_BRANCH=main
# Trusted host-side fetch/push URL. Local paths are useful for offline testing.
LAB_UPSTREAM_URL=https://github.com/example/commitment-lab.git

OLLAMA_ENDPOINT=http://host.containers.internal:11434
OLLAMA_MODEL=devstral-small-2-32k
OLLAMA_CONTEXT=32768
OLLAMA_OUTPUT=8192
SESSION_TIMEOUT=7200
SCHEDULE=daily

# checkpoint: synchronize and create local outcome/checkpoint commits, but never push.
# push: after a successful session, ask the installed trusted publisher to push.
PUBLISH_MODE=checkpoint

CONTAINER_IMAGE=localhost/commitment:installed
# Fresh runs reconstruct continuity from Git, runlog.jsonl, memory/, queue/,
# and checkpoints. Set true manually only when native OpenCode continuation is desired.
CONTINUE_SESSION=false
# Subagents can materially increase RAM, VRAM, and model-server load.
ALLOW_SUBAGENTS=false

GIT_AUTHOR_NAME=Commitment
GIT_AUTHOR_EMAIL=commitment@localhost
# The launcher supplies matching committer values unless these are overridden.
# GIT_COMMITTER_NAME=Commitment
# GIT_COMMITTER_EMAIL=commitment@localhost

# Optional, repository-specific credentials. Kept on the host and never mounted
# or passed to an agent container.
COMMITMENT_GITHUB_TOKEN_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/commitment/commitment-github-token
LAB_GITHUB_TOKEN_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/commitment/lab-github-token

# Optional Commitment-owned Secrets Manager project; never the personal vault.
# Token file stays host-side (owner-only, regular file, outside creative mounts).
# When enabled, explicit ./install.sh installs the pinned official SDK in a
# Commitment-owned host venv. See requests/README.md; no SDK in the creative image.
BITWARDEN_SECRETS_ENABLED=false
BITWARDEN_SECRETS_TOKEN_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/commitment/bitwarden-secrets-token
BITWARDEN_PROJECT_ID=
